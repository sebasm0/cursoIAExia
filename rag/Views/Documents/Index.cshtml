@model IReadOnlyList<RAG.Domain.Entities.Document>
@inject RAG.Application.Services.AssistantCatalog AssistantCatalog
@{
    ViewData["Title"] = "Base de conocimiento";
}

<div class="docs-layout">
    <section class="docs-center">
        <nav aria-label="Ruta de navegación" class="breadcrumb-rag">
            <a asp-controller="Home" asp-action="Index">Home</a>
            <span class="separator" aria-hidden="true">/</span>
            <span class="text-body">Base de conocimiento</span>
        </nav>

        @if (TempData["Message"] is string message)
        {
            <div class="alert alert-success" role="alert">@message</div>
        }
        @if (TempData["Error"] is string error)
        {
            <div class="alert alert-danger" role="alert">@error</div>
        }

        <div class="docs-toolbar">
            <div class="docs-toolbar-left">
                <div class="view-toggle" role="group" aria-label="Vista de documentos">
                    <button type="button" class="view-toggle-btn" data-view-toggle="grid" aria-pressed="false">
                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
                            <path d="M1 2.5A1.5 1.5 0 0 1 2.5 1h3A1.5 1.5 0 0 1 7 2.5v3A1.5 1.5 0 0 1 5.5 7h-3A1.5 1.5 0 0 1 1 5.5zm-1 8A1.5 1.5 0 0 1 2.5 9h3A1.5 1.5 0 0 1 7 10.5v3A1.5 1.5 0 0 1 5.5 15h-3A1.5 1.5 0 0 1 1 13.5zm8-7A1.5 1.5 0 0 1 10.5 2h3A1.5 1.5 0 0 1 15 3.5v3A1.5 1.5 0 0 1 13.5 8h-3A1.5 1.5 0 0 1 9 6.5z"/>
                        </svg>
                        Cuadrícula
                    </button>
                    <button type="button" class="view-toggle-btn" data-view-toggle="list" aria-pressed="true">
                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
                            <path d="M2.5 12a.5.5 0 0 1 .5-.5h10a.5.5 0 0 1 0 1H3a.5.5 0 0 1-.5-.5m0-4a.5.5 0 0 1 .5-.5h10a.5.5 0 0 1 0 1H3a.5.5 0 0 1-.5-.5m0-4a.5.5 0 0 1 .5-.5h10a.5.5 0 0 1 0 1H3a.5.5 0 0 1-.5-.5"/>
                        </svg>
                        Lista
                    </button>
                </div>
            </div>
            <a asp-action="Upload" class="btn btn-primary">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="me-1" viewBox="0 0 16 16" aria-hidden="true">
                    <path d="M8 4a.5.5 0 0 1 .5.5v3h3a.5.5 0 0 1 0 1h-3v3a.5.5 0 0 1-1 0v-3h-3a.5.5 0 0 1 0-1h3v-3A.5.5 0 0 1 8 4"/>
                </svg>
                Agregar nuevo
            </a>
        </div>

        <a asp-action="Upload" class="docs-drop" id="docs-dropzone" title="Subir un documento">
            <div class="card drop-zone drop-zone-compact">
                <span class="drop-zone-icon" aria-hidden="true">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" class="bi bi-cloud-arrow-up" viewBox="0 0 16 16">
                        <path d="M13.405 1.025a1 1 0 0 1 .99.972l1.066 13.314a1 1 0 0 1-.995 1.053H1.534a1 1 0 0 1-.995-1.053L1.605 1.997a1 1 0 0 1 .99-.972zM7.5 3h1a.5.5 0 0 1 .5.5v6.1l2.1-2.1a.5.5 0 0 1 .707.707l-3 3a.5.5 0 0 1-.707 0l-3-3a.5.5 0 0 1 .707-.707L7.5 9.4V3.5a.5.5 0 0 1 .5-.5zM7.5 15H4a2 2 0 0 1 0-4h1v1H4a1 1 0 0 0 0 2h3a2.2 2.2 0 0 0 0-1H5.5a.5.5 0 0 1 0-1H8v3.5h-1.5z"/>
                    </svg>
                </span>
                <span class="drop-zone-title">Arrastre su archivo aquí o haga clic para seleccionar</span>
                <span class="drop-zone-meta">Formatos admitidos: .cs, .md, .pdf. Tamaño máximo: 10 MB. Los archivos se procesan e indexan automáticamente.</span>
            </div>
        </a>

        <div class="card docs-surface">
            <div class="card-header d-flex align-items-center justify-content-between">
                <h2 class="h5 mb-0">Documentos subidos</h2>
                @if (Model is { Count: > 0 })
                {
                    <span class="badge text-bg-light border">@Model.Count</span>
                }
            </div>

            <div class="view-list" id="docsViewList">
                <div class="table-responsive p-0">
                    @if (Model is { Count: > 0 })
                    {
                        <table class="table table-hover align-middle mb-0">
                            <thead>
                                <tr>
                                    <th scope="col">Archivo</th>
                                    <th scope="col">Estado</th>
                                    <th scope="col">Tipo</th>
                                    <th scope="col" class="text-end">Tamaño</th>
                                    <th scope="col">Subido el</th>
                                    <th scope="col" class="text-end">Acciones</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var doc in Model)
                                {
                                    <tr>
                                        <td class="fw-semibold">
                                            <span class="doc-name">
                                                <span class="doc-file-icon" aria-hidden="true">
                                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
                                                        <path d="M14 4.5V14a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V2a2 2 0 0 1 2-2h5.5zm-3 0A1.5 1.5 0 0 1 9.5 3V1H4a1 1 0 0 0-1 1v12a1 1 0 0 0 1 1h8a1 1 0 0 0 1-1V4.5z"/>
                                                    </svg>
                                                </span>
                                                @doc.FileName
                                            </span>
                                        </td>
                                        <td><span class="badge-status is-indexed">Indexado</span></td>
                                        <td><span class="badge text-bg-light border">@doc.ContentType</span></td>
                                        <td class="text-end text-nowrap">@FormatSize(doc.Size)</td>
                                        <td class="text-nowrap">@doc.CreatedAt.ToLocalTime().ToString("g")</td>
                                        <td class="text-end text-nowrap">
                                            <div class="d-inline-flex gap-2">
                                                <a asp-action="View" asp-route-id="@doc.Id" class="btn btn-sm btn-outline-secondary">Ver</a>
                                                @if (ViewData["CanDeleteDocuments"] is true)
                                                {
                                                    <form asp-action="Delete" asp-route-id="@doc.Id" method="post"
                                                          onsubmit="return confirm('¿Eliminar este documento y todos sus bloques indexados? Esta acción no se puede deshacer.');">
                                                        @Html.AntiForgeryToken()
                                                        <button type="submit" class="btn btn-sm btn-outline-danger">
                                                            Eliminar
                                                        </button>
                                                    </form>
                                                }
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                    else if (ViewData["LoadFailed"] is not true)
                    {
                        <p class="text-muted m-0 p-4">Aún no ha subido documentos</p>
                    }
                    else
                    {
                        <p class="text-muted m-0 p-4">No se pudo cargar la lista de documentos. Inténtelo más tarde.</p>
                    }
                </div>
            </div>

            <div class="docs-grid" id="docsViewGrid" hidden>
                @if (Model is { Count: > 0 })
                {
                    foreach (var doc in Model)
                    {
                        <article class="docs-grid-card card">
                            <div class="doc-name">
                                <span class="doc-file-icon" aria-hidden="true">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
                                        <path d="M14 4.5V14a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V2a2 2 0 0 1 2-2h5.5zm-3 0A1.5 1.5 0 0 1 9.5 3V1H4a1 1 0 0 0-1 1v12a1 1 0 0 0 1 1h8a1 1 0 0 0 1-1V4.5z"/>
                                    </svg>
                                </span>
                                <span class="fw-semibold text-break">@doc.FileName</span>
                            </div>
                            <div class="d-flex align-items-center justify-content-between gap-2">
                                <span class="badge-status is-indexed">Indexado</span>
                                <span class="badge text-bg-light border">@doc.ContentType</span>
                            </div>
                            <p class="small text-muted mb-0">
                                @FormatSize(doc.Size) · @doc.CreatedAt.ToLocalTime().ToString("g")
                            </p>
                            <div class="d-flex gap-2">
                                <a asp-action="View" asp-route-id="@doc.Id" class="btn btn-sm btn-outline-secondary">Ver</a>
                                @if (ViewData["CanDeleteDocuments"] is true)
                                {
                                    <form asp-action="Delete" asp-route-id="@doc.Id" method="post"
                                          onsubmit="return confirm('¿Eliminar este documento y todos sus bloques indexados? Esta acción no se puede deshacer.');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-outline-danger">Eliminar</button>
                                    </form>
                                }
                            </div>
                        </article>
                        }
                    }
                else
                {
                    <p class="text-muted p-3">Aún no hay documentos para mostrar en cuadrícula.</p>
                }
            </div>
        </div>
    </section>

    <aside class="docs-chat">
        <div class="chat-panel">
            <div class="chat-panel-header">
                <div class="d-flex align-items-center gap-3">
                    <span class="chat-avatar" aria-hidden="true">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
                            <path d="M8 0c-.039 3-4 2.5-4 6a4 4 0 0 0 8 0c0-3.5-2-3-4-6Zm0 1c-1.1 0-2-.9-2-2 0-1.1.9-2 2-2s2 .9 2 2-.9 2-2 2Z"/>
                        </svg>
                    </span>
                    <div>
                        <span class="chat-panel-title d-block">IA Asistente</span>
                        <span class="status-dot">RAG Activo</span>
                    </div>
                </div>
                <button type="button" class="chat-collapse-btn" id="chat-collapse-toggle"
                        aria-controls="docsChatPanel" aria-expanded="true"
                        aria-label="Ocultar el chat del asistente">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
                        <path d="M8 1.5a.5.5 0 0 1 .5.5v11.793l3.147-3.147a.5.5 0 0 1 .707.708l-4 4a.5.5 0 0 1-.708 0l-4-4a.5.5 0 0 1 .707-.708L7.5 13.793V2a.5.5 0 0 1 .5-.5Z"/>
                    </svg>
                </button>
            </div>
            <div class="chat-messages" id="docsChatPanel">
                <div class="chat-empty">
                    <p class="mb-1 fw-semibold">¿Qué desea preguntar?</p>
                    <p class="mb-0 small">Consulte sus documentos con lenguaje natural y obtenga respuesta con fuentes.</p>
                </div>
            </div>
            <div class="chat-composer">
                <form asp-controller="Ask" asp-action="Ask" method="post" class="d-flex align-items-end gap-2">
                    @Html.AntiForgeryToken()
                    <div class="flex-grow-1">
                        <label for="QueryQuick" class="form-label visually-hidden">Su pregunta</label>
                        <label for="SelectedModelId" class="form-label visually-hidden">Asistente</label>
                        <select name="SelectedModelId" id="SelectedModelId" class="form-select form-select-sm mb-2" aria-label="Asistente">
                            @foreach (var assistant in AssistantCatalog.All)
                            {
                                if (assistant.Id == AssistantCatalog.Default.Id)
                                {
                                    <option value="@assistant.Id" title="@assistant.Description" selected>@assistant.Label — @assistant.Description</option>
                                }
                                else
                                {
                                    <option value="@assistant.Id" title="@assistant.Description">@assistant.Label — @assistant.Description</option>
                                }
                            }
                        </select>
                        <textarea name="Query" id="QueryQuick" class="form-control" rows="2"
                                  placeholder="Pregunte a sus documentos…" required></textarea>
                    </div>
                    <button type="submit" class="btn btn-primary chat-send" aria-label="Enviar pregunta">
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
                            <path d="M15.854.146a.5.5 0 0 1 .11.54l-5.819 14.547a.75.75 0 0 1-1.329.124l-3.178-4.995L.643 7.184a.75.75 0 0 1 .124-1.33L15.314.037a.5.5 0 0 1 .54.11ZM6.94 10.704 8.93 14.39 14.355 2.332 6.94 10.704Z"/>
                        </svg>
                    </button>
                </form>
                <p class="chat-caption">La IA puede cometer errores. Verifique la información importante con los documentos de origen.</p>
            </div>
        </div>
    </aside>

    <button type="button" class="chat-float-open" id="chat-float-open" aria-label="Abrir el chat del asistente">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
            <path d="M8 0c-2 3-4 2.5-4 6a4 4 0 0 0 8 0c0-3.5-2-3-4-6Zm0 1c-1.1 0-2-.9-2-2 0-1.1.9-2 2-2s2 .9 2 2-.9 2-2 2Z"/>
        </svg>
        IA Asistente
    </button>
</div>

@functions {
    static string FormatSize(long bytes) => bytes switch
    {
        >= 1024 * 1024 => $"{bytes / (1024.0 * 1024.0):0.##} MB",
        >= 1024 => $"{bytes / 1024.0:0.##} KB",
        _ => $"{bytes} B",
    };
}