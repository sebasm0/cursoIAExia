@model UploadViewModel
@{
    ViewData["Title"] = Model.ErrorMessage != null ? "Upload Error" : "Upload Successful";
}

<h1>Upload Result</h1>

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-danger" role="alert">
        <h4 class="alert-heading">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" class="bi bi-exclamation-triangle" viewBox="0 0 16 16">
                <path d="M7.938 2.016A.13.13 0 0 1 8.002 2a.13.13 0 0 1 .063.016.146.146 0 0 1 .054.057l6.857 11.667c.036.06.035.124.002.183a.163.163 0 0 1-.054.06.116.116 0 0 1-.066.017H1.146a.115.115 0 0 1-.066-.017.163.163 0 0 1-.054-.06.176.176 0 0 1 .002-.183L7.884 2.073a.147.147 0 0 1 .054-.057zm1.044-.45a1.13 1.13 0 0 0-1.96 0L.165 13.233c-.457.778.091 1.767.98 1.767h13.713c.889 0 1.438-.99.98-1.767L8.982 1.566z"/>
                <path d="M7.002 12a1 1 0 1 1 2 0 1 1 0 0 1-2 0zM7.1 5.995a.905.905 0 1 1 1.8 0l-.35 3.507a.552.552 0 0 1-1.1 0L7.1 5.995z"/>
            </svg>
            Upload Error
        </h4>
        <p>@Model.ErrorMessage</p>
        <hr>
        <p class="mb-0">Check that the file is valid and in a supported format (.cs, .md, .pdf). If the problem persists, verify that Ollama and PostgreSQL are running.</p>
    </div>
}
else
{
    <div class="alert alert-success" role="alert">
        <h4 class="alert-heading">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" class="bi bi-check-circle" viewBox="0 0 16 16">
                <path d="M8 15A7 7 0 1 1 8 1a7 7 0 0 1 0 14zm0 1A8 8 0 1 0 8 0a8 8 0 0 0 0 16z"/>
                <path d="M10.97 4.97a.235.235 0 0 0-.02.022L7.477 9.417 5.384 7.323a.75.75 0 0 0-1.06 1.06L6.97 11.03a.75.75 0 0 0 1.079-.02l3.992-4.99a.75.75 0 0 0-1.071-1.05z"/>
            </svg>
            Document Ingested Successfully
        </h4>
    </div>

    <div class="card mb-3">
        <div class="card-header">
            <strong>Document Details</strong>
        </div>
        <div class="card-body">
            <dl class="row mb-0">
                <dt class="col-sm-3">File Name</dt>
                <dd class="col-sm-9">@Model.FileName</dd>

                <dt class="col-sm-3">Content Type</dt>
                <dd class="col-sm-9">@Model.ContentType</dd>

                <dt class="col-sm-3">File Size</dt>
                <dd class="col-sm-9">
                    @if (Model.FileSize >= 1024 * 1024)
                    {
                        <text>@($"{Model.FileSize / (1024.0 * 1024.0):F2}") MB</text>
                    }
                    else if (Model.FileSize >= 1024)
                    {
                        <text>@($"{Model.FileSize / 1024.0:F1}") KB</text>
                    }
                    else
                    {
                        <text>@Model.FileSize bytes</text>
                    }
                </dd>

                <dt class="col-sm-3">Ingested At</dt>
                <dd class="col-sm-9">@Model.Timestamp.ToString("yyyy-MM-dd HH:mm:ss UTC")</dd>
            </dl>
        </div>
    </div>
}

<div class="mt-4">
    <a asp-action="Index" class="btn btn-outline-primary">Upload Another Document</a>
    <a asp-controller="Ask" asp-action="Index" class="btn btn-outline-primary">Ask a Question</a>
    <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">Back to Home</a>
</div>
