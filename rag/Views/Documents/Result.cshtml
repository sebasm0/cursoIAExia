@model UploadViewModel
@{
    ViewData["Title"] = Model.ErrorMessage != null ? "Error al subir" : "Subido correctamente";
}

<div class="py-4">
    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="card error-card">
            <div class="card-body p-4">
                <div class="d-flex align-items-start gap-3">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" class="bi bi-exclamation-triangle text-danger flex-shrink-0" viewBox="0 0 16 16" aria-hidden="true">
                        <path d="M7.938 2.016A.13.13 0 0 1 8.002 2a.13.13 0 0 1 .063.016.146.146 0 0 1 .054.057l6.857 11.667c.036.06.035.124.002.183a.163.163 0 0 1-.054.06.116.116 0 0 1-.066.017H1.146a.115.115 0 0 1-.066-.017.163.163 0 0 1-.054-.06.176.176 0 0 1 .002-.183L7.884 2.073a.147.147 0 0 1 .054-.057zm1.044-.45a1.13 1.13 0 0 0-1.96 0L.165 13.233c-.457.778.091 1.767.98 1.767h13.713c.889 0 1.438-.99.98-1.767L8.982 1.566z"/>
                        <path d="M7.002 12a1 1 0 1 1 2 0 1 1 0 0 1-2 0zM7.1 5.995a.905.905 0 1 1 1.8 0l-.35 3.507a.552.552 0 0 1-1.1 0L7.1 5.995z"/>
                    </svg>
                    <div>
                        <h1 class="h4 mb-2">Error al subir</h1>
                        <p class="mb-2">@Model.ErrorMessage</p>
                        <p class="mb-0 text-muted">Verifique que el archivo use un formato admitido: .cs, .md o .pdf.</p>
                    </div>
                </div>
                <div class="mt-4 d-flex gap-2">
                    <a asp-action="Upload" class="btn btn-primary">Intentar de nuevo</a>
                    <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">Volver al inicio</a>
                </div>
            </div>
        </div>
    }
    else
    {
        <h1 class="display-6 mb-2">Subido correctamente</h1>
        <p class="lead mb-4">Este documento ya es accesible mediante el buscador.</p>

        <div class="card mb-4">
            <div class="card-header fw-semibold">Detalles del documento</div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-3">Archivo</dt>
                    <dd class="col-sm-9">@Model.FileName</dd>

                    <dt class="col-sm-3">Tipo de contenido</dt>
                    <dd class="col-sm-9">@Model.ContentType</dd>

                    <dt class="col-sm-3">Tamaño del archivo</dt>
                    <dd class="col-sm-9">
                        @if (Model.FileSize >= 1024 * 1024)
                        {
                            <text>@($"{Model.FileSize / (1024.0 * 1024.0):F2}") MB</text>
                        }
                        else if (Model.FileSize >= 1024)
                        {
                            <text>@($"{Model.FileSize / 1024.0:F1}") KB</text>
                        }
                        else
                        {
                            <text>@Model.FileSize bytes</text>
                        }
                    </dd>

                    <dt class="col-sm-3">Ingresado</dt>
                    <dd class="col-sm-9">@Model.Timestamp.ToString("yyyy-MM-dd HH:mm:ss UTC")</dd>
                </dl>
            </div>
        </div>

        <div class="d-flex flex-wrap gap-2">
            <a asp-action="Upload" class="btn btn-outline-primary">Subir otro documento</a>
            <a asp-controller="Ask" asp-action="Index" class="btn btn-outline-primary">Hacer una pregunta</a>
            <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">Volver al inicio</a>
        </div>
    }
</div>
