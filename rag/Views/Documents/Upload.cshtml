@model UploadViewModel
@{
    ViewData["Title"] = "Upload a Document";
}

<div class="py-4">
    <h1 class="display-6 mb-2">Upload a Document</h1>
    <p class="lead mb-4">Add a supported file to make it searchable through the Ask interface.</p>

    <div class="row">
        <div class="col-lg-7 col-xl-6">
            <div class="card">
                <div class="card-body p-4">
                    <form asp-action="Upload" method="post" enctype="multipart/form-data">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="mb-3">
                            <label for="file" class="form-label">Select file</label>
                            <input type="file"
                                   name="file"
                                   id="file"
                                   class="form-control"
                                   accept=".cs,.md,.pdf"
                                   required />
                            <div class="form-text">Accepted formats: .cs (C#), .md (Markdown), .pdf (PDF). Maximum size: 10 MB.</div>
                            <span class="text-danger" id="file-validation"></span>
                        </div>

                        <button type="submit" class="btn btn-primary">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-upload me-1" viewBox="0 0 16 16" aria-hidden="true">
                                <path d="M.5 9.9a.5.5 0 0 1 .5.5v2.5a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1v-2.5a.5.5 0 0 1 1 0v2.5a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2v-2.5a.5.5 0 0 1 .5-.5z"/>
                                <path d="M7.646 1.146a.5.5 0 0 1 .708 0l3 3a.5.5 0 0 1-.708.708L8.5 2.707V11.5a.5.5 0 0 1-1 0V2.707L5.354 4.854a.5.5 0 1 1-.708-.708l3-3z"/>
                            </svg>
                            Upload
                        </button>
                    </form>
                </div>
            </div>

            <p class="text-muted small mt-3">Files are parsed, chunked and indexed for semantic search.</p>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}

    <script>
        document.getElementById('file')?.addEventListener('change', function () {
            const validation = document.getElementById('file-validation');
            const maxSize = 10 * 1024 * 1024; // 10 MB

            if (this.files.length === 0) {
                validation.textContent = '';
                return;
            }

            const file = this.files[0];
            const ext = file.name.substring(file.name.lastIndexOf('.')).toLowerCase();

            if (!['.cs', '.md', '.pdf'].includes(ext)) {
                validation.textContent = 'Unsupported file type. Accepted formats: .cs, .md, .pdf.';
                this.value = '';
                return;
            }

            if (file.size > maxSize) {
                validation.textContent = 'File exceeds the maximum upload size of 10 MB.';
                this.value = '';
                return;
            }

            validation.textContent = '';
        });
    </script>
}
