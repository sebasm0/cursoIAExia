@model ForgotPasswordViewModel
@{
    ViewData["Title"] = "Forgot your password?";
}

<div class="row justify-content-center py-4">
    <div class="col-12 col-md-8 col-lg-5">
        <div class="card form-card">
            <div class="card-body p-4 p-md-5">
                <h1 class="h3 mb-1">Forgot your password?</h1>
                <p class="text-secondary mb-4">Enter your email and we'll send you a link to reset your password.</p>

                @if (ViewData["Message"] is string message)
                {
                    <div class="alert alert-success" role="alert">@message</div>
                }

                <form asp-action="ForgotPassword" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label"></label>
                        <input asp-for="Email" class="form-control" autocomplete="email" />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>

                    <button type="submit" class="btn btn-primary w-100">Send reset link</button>
                </form>

                <p class="mt-3 mb-0 text-center">
                    <a asp-action="Login">Back to login</a>
                </p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
