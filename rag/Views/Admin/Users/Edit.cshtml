@model EditUserViewModel
@{
    ViewData["Title"] = "Editar usuario";
}

<div class="row justify-content-center py-4">
    <div class="col-12 col-md-8 col-lg-6">
        <div class="card form-card">
            <div class="card-body p-4 p-md-5">
                <h1 class="h3 mb-1">Editar usuario</h1>
                <p class="text-muted mb-4">Actualice el correo electrónico y la asignación de roles. El nombre de usuario no puede cambiar.</p>

                <form asp-action="UsersEdit" asp-route-id="@Model.UserId" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="UserName" class="form-label"></label>
                        <input asp-for="UserName" class="form-control" disabled />
                    </div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label"></label>
                        <input asp-for="Email" class="form-control" autocomplete="off" />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>

                    <fieldset class="mb-4">
                        <legend class="form-label mb-2">Roles</legend>
                        @foreach (var role in Model.AvailableRoles)
                        {
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" name="SelectedRoles"
                                       value="@role" id="role-@role"
                                       checked="@Model.SelectedRoles.Contains(role)" />
                                <label class="form-check-label" for="role-@role">@role</label>
                            </div>
                        }
                    </fieldset>

                    <button type="submit" class="btn btn-primary">Guardar</button>
                    <a asp-action="Users" class="btn btn-link">Volver a la lista</a>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
