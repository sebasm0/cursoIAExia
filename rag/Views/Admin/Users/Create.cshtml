@model CreateUserViewModel
@{
    ViewData["Title"] = "Crear usuario";
}

<div class="row justify-content-center py-4">
    <div class="col-12 col-md-8 col-lg-6">
        <div class="card form-card">
            <div class="card-body p-4 p-md-5">
                <h1 class="h3 mb-1">Crear usuario</h1>
                <p class="text-muted mb-4">Cree una cuenta y asigne sus roles iniciales.</p>

                <form asp-action="UsersCreate" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="UserName" class="form-label"></label>
                        <input asp-for="UserName" class="form-control" autocomplete="off" />
                        <span asp-validation-for="UserName" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label"></label>
                        <input asp-for="Email" class="form-control" autocomplete="off" />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Password" class="form-label"></label>
                        <input asp-for="Password" class="form-control" autocomplete="new-password" />
                        <span asp-validation-for="Password" class="text-danger"></span>
                    </div>

                    <fieldset class="mb-4">
                        <legend class="form-label mb-2">Roles</legend>
                        @foreach (var role in Model.AvailableRoles)
                        {
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" name="SelectedRoles"
                                       value="@role" id="role-@role" />
                                <label class="form-check-label" for="role-@role">@role</label>
                            </div>
                        }
                    </fieldset>

                    <button type="submit" class="btn btn-primary">Crear usuario</button>
                    <a asp-action="Users" class="btn btn-link">Volver a la lista</a>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
