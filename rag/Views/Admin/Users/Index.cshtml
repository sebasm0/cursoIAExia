@model UsersIndexViewModel
@{
    ViewData["Title"] = "Usuarios";
    var currentUserId = ViewData["CurrentUserId"]?.ToString();
}

<div class="py-4">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-4">
        <div>
            <h1 class="display-6 mb-1">Usuarios</h1>
            <p class="text-muted mb-0">Gestione cuentas y asignación de roles en el sistema RAG.</p>
        </div>
        <a asp-action="UsersCreate" class="btn btn-primary">Crear usuario</a>
    </div>

    @if (TempData["AdminError"] is string error)
    {
        <div class="alert alert-danger" role="alert">@error</div>
    }

    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th scope="col">Usuario</th>
                    <th scope="col">Correo electrónico</th>
                    <th scope="col">Roles</th>
                    <th scope="col" class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var user in Model.Users)
                {
                    <tr>
                        <td class="fw-medium">@user.UserName</td>
                        <td>@user.Email</td>
                        <td>@string.Join(", ", user.Roles)</td>
                        <td class="text-end text-nowrap">
                            <a asp-action="UsersEdit" asp-route-id="@user.Id" class="btn btn-outline-secondary btn-sm">Editar</a>
                            @if (user.Id.ToString() != currentUserId)
                            {
                                <form id="delete-user-@user.Id" class="d-inline" asp-action="UsersDelete" asp-route-id="@user.Id" method="post">
                                    <button type="button" class="btn btn-outline-danger btn-sm" data-bs-toggle="modal" data-bs-target="#confirmModal-@user.Id">Eliminar</button>
                                    <noscript><button type="submit" class="btn btn-outline-danger btn-sm">Eliminar</button></noscript>
                                </form>
                                @await Html.PartialAsync("_ConfirmModal", new ConfirmModalViewModel
                                {
                                    ModalId = "confirmModal-" + user.Id,
                                    FormId = "delete-user-" + user.Id,
                                    Title = "Eliminar usuario",
                                    Message = $"¿Eliminar a {user.UserName}? Esta acción no se puede deshacer.",
                                    ConfirmLabel = "Eliminar",
                                    ConfirmClass = "btn-danger",
                                })
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
