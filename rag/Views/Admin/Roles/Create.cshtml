@{
    ViewData["Title"] = "Create role";
}

<h1 class="display-6">Create role</h1>

<div class="row">
    <div class="col-md-6 col-lg-5">
        <form asp-action="RolesCreate" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label for="roleName" class="form-label">Role name</label>
                <input id="roleName" name="roleName" class="form-control" autocomplete="off" />
            </div>

            <button type="submit" class="btn btn-primary">Create role</button>
            <a asp-action="Roles" class="btn btn-link">Back to list</a>
        </form>
    </div>
</div>
