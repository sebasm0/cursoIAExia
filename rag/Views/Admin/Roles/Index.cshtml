@model RolesIndexViewModel
@{
    ViewData["Title"] = "Roles";
}

<div class="py-4">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-4">
        <div>
            <h1 class="display-6 mb-1">Roles</h1>
            <p class="text-muted mb-0">Defina los roles y los permisos que concede cada uno.</p>
        </div>
        <a asp-action="RolesCreate" class="btn btn-primary">Crear rol</a>
    </div>

    @if (TempData["AdminError"] is string error)
    {
        <div class="alert alert-danger" role="alert">@error</div>
    }

    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th scope="col">Rol</th>
                    <th scope="col">Permisos</th>
                    <th scope="col">Usuarios</th>
                    <th scope="col" class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var role in Model.Roles)
                {
                    <tr>
                        <td class="fw-medium">@role.Name</td>
                        <td>@role.PermissionCount</td>
                        <td>@role.MemberCount</td>
                        <td class="text-end text-nowrap">
                            <a asp-action="RolesEdit" asp-route-id="@role.Id" class="btn btn-outline-secondary btn-sm">Permisos</a>
                            @if (!role.IsBuiltIn && role.MemberCount == 0)
                            {
                                <form id="delete-role-@role.Id" class="d-inline" asp-action="RolesDelete" asp-route-id="@role.Id" method="post">
                                    <button type="button" class="btn btn-outline-danger btn-sm" data-bs-toggle="modal" data-bs-target="#confirmModal-@role.Id">Eliminar</button>
                                    <noscript><button type="submit" class="btn btn-outline-danger btn-sm">Eliminar</button></noscript>
                                </form>
                                @await Html.PartialAsync("_ConfirmModal", new ConfirmModalViewModel
                                {
                                    ModalId = "confirmModal-" + role.Id,
                                    FormId = "delete-role-" + role.Id,
                                    Title = "Eliminar rol",
                                    Message = $"¿Eliminar el rol {role.Name}? Esta acción no se puede deshacer.",
                                    ConfirmLabel = "Eliminar",
                                    ConfirmClass = "btn-danger",
                                })
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
