@model RolesIndexViewModel
@{
    ViewData["Title"] = "Roles";
}

<h1 class="display-6">Roles</h1>

@if (TempData["AdminError"] is string error)
{
    <div class="alert alert-danger" role="alert">@error</div>
}

<p>
    <a asp-action="RolesCreate" class="btn btn-primary btn-sm">Create role</a>
</p>

<table class="table table-sm table-hover">
    <thead>
        <tr>
            <th>Role</th>
            <th>Permissions</th>
            <th>Users</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var role in Model.Roles)
        {
            <tr>
                <td>@role.Name</td>
                <td>@role.PermissionCount</td>
                <td>@role.MemberCount</td>
                <td class="text-end">
                    <a asp-action="RolesEdit" asp-route-id="@role.Id" class="btn btn-outline-secondary btn-sm">Permissions</a>
                    @if (!role.IsBuiltIn && role.MemberCount == 0)
                    {
                        <form id="delete-role-@role.Id" class="d-inline" asp-action="RolesDelete" asp-route-id="@role.Id" method="post">
                            <button type="button" class="btn btn-outline-danger btn-sm" data-bs-toggle="modal" data-bs-target="#confirmModal-@role.Id">Delete</button>
                        </form>
                        @await Html.PartialAsync("_ConfirmModal", new ConfirmModalViewModel
                        {
                            ModalId = "confirmModal-" + role.Id,
                            FormId = "delete-role-" + role.Id,
                            Title = "Delete role",
                            Message = $"Delete role {role.Name}? This action cannot be undone.",
                            ConfirmLabel = "Delete",
                            ConfirmClass = "btn-danger",
                        })
                    }
                </td>
            </tr>
        }
    </tbody>
</table>
