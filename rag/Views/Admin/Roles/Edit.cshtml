@model RolePermissionsViewModel
@{
    ViewData["Title"] = $"Permissions — {Model.RoleName}";
}

<h1 class="display-6">Permissions</h1>
<p class="text-muted">Role: <strong>@Model.RoleName</strong></p>

<form asp-action="RolesEdit" asp-route-id="@Model.RoleId" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

    <table class="table table-sm table-hover">
        <thead>
            <tr>
                <th>Permission</th>
                <th>Granted</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Permissions)
            {
                <tr>
                    <td>
                        <label class="form-check-label" for="perm-@item.Permission">@item.Permission</label>
                    </td>
                    <td>
                        <input class="form-check-input" type="checkbox" name="SelectedPermissions"
                               value="@item.Permission" id="perm-@item.Permission"
                               checked="@item.IsChecked" />
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <button type="submit" class="btn btn-primary">Save permissions</button>
    <a asp-action="Roles" class="btn btn-link">Back to list</a>
</form>
