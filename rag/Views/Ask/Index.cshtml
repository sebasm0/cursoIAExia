@model AskViewModel
@{
    ViewData["Title"] = "Preguntar";
    string? initials = null;
    if (User.Identity!.IsAuthenticated && !string.IsNullOrWhiteSpace(User.Identity.Name))
    {
        initials = string.Concat(User.Identity.Name.Split(' ').Take(2).Select(p => p.Length > 0 ? p[0] : ' '));
    }
}

<div class="chat-panel chat-standalone">
    <div class="chat-panel-header">
        <div class="d-flex align-items-center gap-3">
            <span class="chat-avatar" aria-hidden="true">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
                    <path d="M8 0c-2 3-4 2.5-4 6a4 4 0 0 0 8 0c0-3.5-2-3-4-6Zm0 10c-1.1 0-2-.9-2-2 0-1.1.9-2 2-2s2 .9 2 2-.9 2-2 2Z"/>
                </svg>
            </span>
            <div>
                <span class="chat-panel-title d-block">AI Assistant</span>
                <span class="status-dot">RAG Activo</span>
            </div>
        </div>
        <a asp-action="Index" class="btn btn-outline-primary btn-sm">+ Nuevo</a>
    </div>

    <div class="chat-messages" role="log" aria-live="polite">
        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="msg-bubble msg-error">@Model.ErrorMessage</div>
            <div class="chat-empty">
                <p class="mb-0">El servicio RAG no está disponible. Verifique que Ollama y PostgreSQL estén en ejecución e intente de nuevo.</p>
            </div>
        }
        else if (!string.IsNullOrEmpty(Model.Answer))
        {
            <div class="msg-row msg-row-user">
                <div class="msg-bubble msg-user">@Model.Query</div>
                <span class="msg-author-avatar" aria-hidden="true">@initials</span>
            </div>
            <div class="msg-row msg-row-assistant">
                <span class="msg-assistant-icon" aria-hidden="true">
                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
                        <path d="M3.5 6.5A1.5 1.5 0 0 1 5 5h6a1.5 1.5 0 0 1 1.5 1.5v3A1.5 1.5 0 0 1 11 11H5a1.5 1.5 0 0 1-1.5-1.5z"/>
                        <path d="M8 10a2 2 0 0 1-2-2V3a2 2 0 1 1 4 0v5a2 2 0 0 1-2 2zM3 13.5a.5.5 0 0 1 .5-.5h9a.5.5 0 0 1 0 1h-9a.5.5 0 0 1-.5-.5z"/>
                    </svg>
                </span>
                <div class="msg-bubble msg-assistant">@Model.Answer</div>
            </div>
        }
        else
        {
            <div class="chat-empty">
                <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" fill="currentColor" class="mb-2 text-primary" viewBox="0 0 16 16" aria-hidden="true">
                    <path d="M8 16A8 8 0 1 1 8 0a8 8 0 0 1 0 16M7 3a1 1 0 0 0 0 2h1.586L5.207 8.379a1 1 0 0 0 1.414 1.414L10 6.414V8a1 1 0 0 0 2 0V4a1.5 1.5 0 0 0-1.5-1.5z"/>
                    <path d="M5 13h6a1 1 0 0 1 0 2H5a1 1 0 0 1 0-2Z"/>
                </svg>
                <p class="mb-1 fw-semibold">Pregunte sobre sus documentos</p>
                <p class="mb-0 small">Las respuestas se generan únicamente a partir de sus documentos indexados.</p>
            </div>
        }
    </div>

    <div class="chat-composer">
        <form asp-action="Ask" method="post" class="d-flex align-items-end gap-2">
            <div class="flex-grow-1">
                <div asp-validation-summary="ModelOnly" class="text-danger small mb-2"></div>
                <label asp-for="Query" class="form-label visually-hidden">Su pregunta</label>
                <textarea asp-for="Query" class="form-control" rows="2"
                          placeholder="¿Qué desea saber sobre sus documentos?" required></textarea>
                <span asp-validation-for="Query" class="text-danger small"></span>
            </div>
            <button type="submit" class="btn btn-primary chat-send" aria-label="Enviar pregunta">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
                    <path d="M15.854.146a.5.5 0 0 1 .11.54l-5.819 14.547a.75.75 0 0 1-1.329.124l-3.178-4.995L.643 7.184a.75.75 0 0 1 .124-1.33L15.314.037a.5.5 0 0 1 .54.11ZM6.94 10.704 8.93 14.39 14.355 2.332 6.94 10.704Z"/>
                </svg>
            </button>
        </form>
        <p class="chat-caption">La IA puede cometer errores. Verifique siempre la información importante con los documentos de origen.</p>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}