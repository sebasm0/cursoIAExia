@model AskViewModel
@{
    ViewData["Title"] = "Respuesta";
    string? initials = null;
    if (User.Identity!.IsAuthenticated && !string.IsNullOrWhiteSpace(User.Identity.Name))
    {
        initials = string.Concat(User.Identity.Name.Split(' ').Take(2).Select(p => p.Length > 0 ? p[0] : ' '));
    }
}

<div class="py-4">
    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="card error-card">
            <div class="card-body p-4">
                <div class="d-flex align-items-start gap-3">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" class="bi bi-exclamation-triangle text-danger flex-shrink-0" viewBox="0 0 16 16" aria-hidden="true">
                        <path d="M7.938 2.016A.13.13 0 0 1 8.002 2a.13.13 0 0 1 .063.016.146.146 0 0 1 .054.057l6.857 11.667c.036.06.035.124.002.183a.163.163 0 0 1-.054.06.116.116 0 0 1-.066.017H1.146a.115.115 0 0 1-.066-.017.163.163 0 0 1-.054-.06.176.176 0 0 1 .002-.183L7.884 2.073a.147.147 0 0 1 .054-.057zm1.044-.45a1.13 1.13 0 0 0-1.96 0L.165 13.233c-.457.778.091 1.767.98 1.767h13.713c.889 0 1.438-.99.98-1.767L8.982 1.566z"/>
                        <path d="M7.002 12a1 1 0 1 1 2 0 1 1 0 0 1-2 0zM7.1 5.995a.905.905 0 1 1 1.8 0l-.35 3.507a.552.552 0 0 1-1.1 0L7.1 5.995z"/>
                    </svg>
                    <div>
                        <h1 class="h4 mb-2">Servicio no disponible</h1>
                        <p class="mb-2">@Model.ErrorMessage</p>
                        <p class="mb-0 text-muted">El servicio no está disponible. Intente de nuevo en unos minutos. Si el problema persiste, verifique que Ollama y PostgreSQL estén en ejecución.</p>
                    </div>
                </div>
                <div class="mt-4 d-flex gap-2">
                    <a asp-action="Index" class="btn btn-primary">Intentar de nuevo</a>
                    <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">Volver al inicio</a>
                </div>
            </div>
        </div>
    }
    else if (!string.IsNullOrEmpty(Model.Answer))
    {
        <h1 class="display-6 mb-4">Respuesta</h1>

        <div class="card mb-3">
            <div class="card-header fw-semibold d-flex align-items-center gap-2">
                <span class="msg-author-avatar" aria-hidden="true">@initials</span>
                Su pregunta
            </div>
            <div class="card-body">
                <p class="card-text mb-0">@Model.Query</p>
            </div>
        </div>

        <div class="card mb-4">
            <div class="card-header fw-semibold d-flex align-items-center gap-2">
                <span class="msg-assistant-icon" aria-hidden="true">
                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
                        <path d="M3.5 6.5A1.5 1.5 0 0 1 5 5h6a1.5 1.5 0 0 1 1.5 1.5v3A1.5 1.5 0 0 1 11 11H5a1.5 1.5 0 0 1-1.5-1.5z"/>
                        <path d="M8 10a2 2 0 0 1-2-2V3a2 2 0 1 1 4 0v5a2 2 0 0 1-2 2zM3 13.5a.5.5 0 0 1 .5-.5h9a.5.5 0 0 1 0 1h-9a.5.5 0 0 1-.5-.5z"/>
                    </svg>
                </span>
                Respuesta
            </div>
            <div class="card-body">
                <pre class="mb-0" style="white-space: pre-wrap; font-family: inherit;">@Model.Answer</pre>
            </div>
        </div>

        <div class="d-flex gap-2">
            <a asp-action="Index" class="btn btn-outline-primary">Hacer otra pregunta</a>
            <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">Volver al inicio</a>
        </div>
    }
    else
    {
        <div class="card">
            <div class="card-body p-4">
                <h1 class="h4 mb-2">No se generó respuesta alguna</h1>
                <p class="mb-0">El servicio RAG devolvió una respuesta vacía. Intente con su pregunta de nuevo o consulte más tarde.</p>
                <div class="mt-4 d-flex gap-2">
                    <a asp-action="Index" class="btn btn-primary">Intentar de nuevo</a>
                    <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">Volver al inicio</a>
                </div>
            </div>
        </div>
    }
</div>
