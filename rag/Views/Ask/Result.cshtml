@model AskViewModel
@{
    ViewData["Title"] = "Answer";
}

<div class="py-4">
    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="card error-card">
            <div class="card-body p-4">
                <div class="d-flex align-items-start gap-3">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" class="bi bi-exclamation-triangle text-danger flex-shrink-0" viewBox="0 0 16 16" aria-hidden="true">
                        <path d="M7.938 2.016A.13.13 0 0 1 8.002 2a.13.13 0 0 1 .063.016.146.146 0 0 1 .054.057l6.857 11.667c.036.06.035.124.002.183a.163.163 0 0 1-.054.06.116.116 0 0 1-.066.017H1.146a.115.115 0 0 1-.066-.017.163.163 0 0 1-.054-.06.176.176 0 0 1 .002-.183L7.884 2.073a.147.147 0 0 1 .054-.057zm1.044-.45a1.13 1.13 0 0 0-1.96 0L.165 13.233c-.457.778.091 1.767.98 1.767h13.713c.889 0 1.438-.99.98-1.767L8.982 1.566z"/>
                        <path d="M7.002 12a1 1 0 1 1 2 0 1 1 0 0 1-2 0zM7.1 5.995a.905.905 0 1 1 1.8 0l-.35 3.507a.552.552 0 0 1-1.1 0L7.1 5.995z"/>
                    </svg>
                    <div>
                        <h1 class="h4 mb-2">Service unavailable</h1>
                        <p class="mb-2">@Model.ErrorMessage</p>
                        <p class="mb-0 text-muted">Please try again in a few minutes. If the problem persists, check that Ollama and PostgreSQL are running.</p>
                    </div>
                </div>
                <div class="mt-4 d-flex gap-2">
                    <a asp-action="Index" class="btn btn-primary">Try Again</a>
                    <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">Back to Home</a>
                </div>
            </div>
        </div>
    }
    else if (!string.IsNullOrEmpty(Model.Answer))
    {
        <h1 class="display-6 mb-4">Answer</h1>

        <div class="card mb-3">
            <div class="card-header fw-semibold">Your question</div>
            <div class="card-body">
                <p class="card-text mb-0">@Model.Query</p>
            </div>
        </div>

        <div class="card mb-4">
            <div class="card-header fw-semibold">Answer</div>
            <div class="card-body">
                <pre class="mb-0" style="white-space: pre-wrap; font-family: inherit;">@Model.Answer</pre>
            </div>
        </div>

        <div class="d-flex gap-2">
            <a asp-action="Index" class="btn btn-outline-primary">Ask another</a>
            <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">Back to Home</a>
        </div>
    }
    else
    {
        <div class="card">
            <div class="card-body p-4">
                <h1 class="h4 mb-2">No answer was generated</h1>
                <p class="mb-0">The RAG service returned an empty response. Please try your question again or check back later.</p>
                <div class="mt-4 d-flex gap-2">
                    <a asp-action="Index" class="btn btn-primary">Try Again</a>
                    <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">Back to Home</a>
                </div>
            </div>
        </div>
    }
</div>
