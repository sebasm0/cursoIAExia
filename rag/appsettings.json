{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "AI": {
    "Provider": "Ollama",
    "Ollama": {
      "BaseUrl": "http://localhost:11434",
      "ChatModel": "phi3:mini",
      "EmbeddingModel": "nomic-embed-text",
      "Assistants": [
        {
          "id": "default",
          "label": "Phi3 Mini",
          "model": "phi3:mini",
          "description": "Equilibrio entre calidad y velocidad"
        },
        {
          "id": "fast",
          "label": "Qwen 2.5 1.5B",
          "model": "qwen2.5:1.5b",
          "description": "Más rápido manteniendo buena calidad"
        },
        {
          "id": "tiny",
          "label": "Llama 3.2 1B",
          "model": "llama3.2:1b",
          "description": "La opción más rápida"
        }
      ]
    }
  },
  "DocumentUpload": {
    "MaxFileSize": 10485760
  },
  "ConnectionStrings": {
    "PostgreSQL": "Host=localhost;Database=rag;Username=postgres;Password=__SECRET__"
  },
  "Identity": {
    "ApplyMigrationsOnStartup": true,
    "SeedAdmin": {
      "UserName": "admin",
      "Email": "__SECRET__",
      "Password": "__SECRET__"
    }
  }
}
